<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ManuelTAi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>

        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_brand_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke</item>

        <item name="materialCardViewStyle">@style/Widget.ManuelTAi.Card</item>
        <item name="textInputStyle">@style/Widget.ManuelTAi.TextInputLayout</item>
        <item name="toolbarStyle">@style/Widget.ManuelTAi.Toolbar</item>
    </style>
</resources>
