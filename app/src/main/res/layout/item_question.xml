<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/questionPromptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="1. What is 3/4 + 1/4?" />

        <TextView
            android:id="@+id/questionOptionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="A) 1/2\nB) 1\nC) 3/8\nD) 4/8"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/questionAnswerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#2457C5"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Answer: B"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/questionExplanationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Add the numerators since denominators match."
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
